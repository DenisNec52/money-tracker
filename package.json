{
  "name": "spese-personali-workspace",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:seed": "pnpm --filter @workspace/scripts run seed",
    "codegen": "pnpm --filter @workspace/api-spec run codegen",
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/spese-personali run dev",
    "typecheck": "tsc --build && pnpm -r --filter \"./artifacts/**\" --filter ./scripts --if-present run typecheck",
    "build": "pnpm run typecheck && pnpm -r --if-present run build"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=22.9"
  }
}
